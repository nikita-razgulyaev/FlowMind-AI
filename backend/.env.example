# ───────────────────────── Режим развёртывания ─────────────────────────
# local — для себя: без регистрации и лимитов, SQLite, Ollama по умолчанию
# cloud — сервис для пользователей: регистрация, тарифы, оплата
DEPLOYMENT_MODE=local

# По умолчанию SQLite-файл рядом с backend. Для облака используйте PostgreSQL:
#   DATABASE_URL=postgresql://user:password@host:5432/flowmind
DATABASE_URL=sqlite+aiosqlite:///./flowmind.db

# Применять миграции Alembic при старте (для нескольких инстансов — выключите и запускайте `alembic upgrade head` отдельно)
AUTO_MIGRATE=true

# ───────────────────────── Безопасность (обязательно для cloud) ─────────────────────────
# Длинная случайная строка:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Ключ шифрования секретов подключений (API-ключи, токены ботов). Если пусто — берётся из SECRET_KEY.
# Не меняйте после запуска: ранее сохранённые секреты перестанут расшифровываться.
ENCRYPTION_KEY=

# Публичный адрес сервиса (нужен для вебхуков Telegram и возврата с оплаты), например https://flowmind.example.com
PUBLIC_BASE_URL=
# Адрес фронтенда в режиме разработки (vite)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ───────────────────────── Аккаунты ─────────────────────────
# Аккаунт с этим email получает права администратора. Если задан и пароль — создаётся при старте.
# Домен должен быть настоящим (example.com подойдёт; .test/.local валидатор отвергнет).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Требовать подтверждение email (нужен SMTP, иначе письма пишутся в лог)
REQUIRE_EMAIL_VERIFICATION=false
# Демо: отдавать ссылки из писем прямо в ответе API и открыть /api/docs. НЕ включайте для реальных пользователей!
DEMO_MODE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowMind AI <no-reply@example.com>

# ───────────────────────── Оплата ─────────────────────────
# mock    — имитация для демо (тестовые карты, деньги не списываются)
# yookassa — реальная оплата через ЮKassa
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Отправлять чек по 54-ФЗ вместе с платежом и его параметры
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
# YOOKASSA_TAX_SYSTEM_CODE=

# ───────────────────────── LLM ─────────────────────────
# Локальные модели (Ollama) — режим local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# AI сервиса: ВСЕ модели одним списком. Первая — основная (по умолчанию OrcaRouter, бесплатная DeepSeek V4 Flash),
# остальные — запасные: при сбое основной запрос автоматически уходит к следующей. Модель должна поддерживать tool calling.
# Достаточно задать ключ основной модели:
ORCAROUTER_API_KEY=
# Свой список (необязательно). Ключ указывайте именем переменной (api_key_env) или напрямую (api_key). Только https.
# PLATFORM_LLM_PROVIDERS=[{"name":"orcarouter","base_url":"https://api.orcarouter.ai/v1","model":"deepseek/deepseek-v4-flash-free","api_key_env":"ORCAROUTER_API_KEY"},{"name":"groq","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile","api_key_env":"GROQ_API_KEY"}]
PLATFORM_LLM_COOLDOWN_SECONDS=60
# Суточный потолок запросов по ключу платформы (меняется в админке)
AI_DAILY_CAP=5000

# ───────────────────────── Telegram ─────────────────────────
# auto: local → long polling, cloud → webhook (если задан PUBLIC_BASE_URL). Можно задать webhook | polling | off
TELEGRAM_MODE=auto

# ───────────────────────── Google OAuth (Таблицы / Календарь) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# По умолчанию: <PUBLIC_BASE_URL или http://localhost:8000>/api/oauth/google/callback
GOOGLE_REDIRECT_URI=

# ───────────────────────── Яндекс OAuth (Почта / Таблицы) ─────────────────────────
# Создайте приложение: https://oauth.yandex.ru/client/new
# Платформа: Веб-сервисы. Redirect URI: <PUBLIC_BASE_URL>/api/oauth/yandex/callback
# Права доступа (Доступ к данным):
#   mail:imap_ro, mail:smtp, login:email  — для Яндекс Почты
#   cloud_api:disk.read, cloud_api:disk.write, cloud_api:disk.info, login:email  — для Яндекс Таблиц
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# По умолчанию: <PUBLIC_BASE_URL или http://localhost:8000>/api/oauth/yandex/callback
YANDEX_REDIRECT_URI=

# ───────────────────────── Ограничения выполнения ─────────────────────────
MAX_EXECUTION_SECONDS=120
MAX_NODES_PER_WORKFLOW=60
MAX_PARALLEL_EXECUTIONS_PER_USER=3
