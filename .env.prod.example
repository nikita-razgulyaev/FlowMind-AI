# Домен, направленный A-записью на сервер (Caddy сам получит HTTPS-сертификат)
DOMAIN=flowmind.example.com
POSTGRES_PASSWORD=change-me-strong-password

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENCRYPTION_KEY=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Оплата: mock — демо, yookassa — реальная
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPTS=false

# AI сервиса: основная модель по умолчанию — OrcaRouter, deepseek/deepseek-v4-flash-free
ORCAROUTER_API_KEY=

# Письма (подтверждение email, сброс пароля)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowMind AI <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# Только для демонстраций!
DEMO_MODE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Вход через Яндекс и Mail.ru (необязательно: без ключей кнопка входа покажет, что сервис не настроен)
# Адреса возврата (укажите их в кабинете разработчика): <BASE_URL>/api/oauth/yandex/callback, .../mailru/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_MAIL_SCOPES=userinfo mail.imap

# Все модели встроенного AI одним списком (необязательно): первая основная, остальные запасные.
# PLATFORM_LLM_PROVIDERS=[{"name":"orcarouter","base_url":"https://api.orcarouter.ai/v1","model":"deepseek/deepseek-v4-flash-free","api_key_env":"ORCAROUTER_API_KEY"},{"name":"groq","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile","api_key_env":"GROQ_API_KEY"}]
PLATFORM_LLM_PROVIDERS=
PLATFORM_LLM_COOLDOWN_SECONDS=60
