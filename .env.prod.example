# Домен, направленный A-записью на сервер (Caddy сам получит HTTPS-сертификат)
DOMAIN=flowmind.example.com
POSTGRES_PASSWORD=change-me-strong-password

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENCRYPTION_KEY=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Оплата: mock — демо, yookassa — реальная
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPTS=false

# AI сервиса (Hugging Face)
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=openai/gpt-oss-120b:groq

# Письма (подтверждение email, сброс пароля)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowMind AI <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# Только для демонстраций!
DEMO_MODE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
